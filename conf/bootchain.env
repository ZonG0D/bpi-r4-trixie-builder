# Bootchain configuration for build-bootchain.sh and build-kernel.sh.
#
# Override any values by exporting environment variables or editing this file.
# Commands are executed from the component source directory.

# Toolchain
CROSS_COMPILE=${CROSS_COMPILE:-aarch64-linux-gnu-}
JOBS=${JOBS:-$(nproc)}

# BL2 / Preloader (set SKIP_BL2=1 to skip)
SKIP_BL2=${SKIP_BL2:-1}
BL2_REPO=${BL2_REPO:-}
BL2_REF=${BL2_REF:-}
BL2_BUILD_CMD=${BL2_BUILD_CMD:-}
BL2_OUTPUTS=()

# Arm Trusted Firmware (TF-A)
TF_A_REPO=${TF_A_REPO:-https://github.com/ARM-software/arm-trusted-firmware.git}
TF_A_REF=${TF_A_REF:-master}
TF_A_PLAT=${TF_A_PLAT:-mt7988}
TF_A_BUILD_CMD=${TF_A_BUILD_CMD:-"make PLAT=${TF_A_PLAT} CROSS_COMPILE=${CROSS_COMPILE} -j${JOBS} bl31"}
TF_A_OUTPUTS=("build/${TF_A_PLAT}/release/bl31.bin")

# U-Boot
UBOOT_REPO=${UBOOT_REPO:-https://github.com/u-boot/u-boot.git}
UBOOT_REF=${UBOOT_REF:-master}
UBOOT_DEFCONFIG=${UBOOT_DEFCONFIG:-mt7988a_bpi-r4_defconfig}
UBOOT_BUILD_CMD=${UBOOT_BUILD_CMD:-"make ${UBOOT_DEFCONFIG} && make -j${JOBS} CROSS_COMPILE=${CROSS_COMPILE}"}
UBOOT_OUTPUTS=("u-boot.bin")
UBOOT_IMAGE_NAME=${UBOOT_IMAGE_NAME:-bpi-r4_sdmmc.img.gz}

# Linux kernel
KERNEL_REPO=${KERNEL_REPO:-https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git}
KERNEL_REF=${KERNEL_REF:-master}
KERNEL_DEFCONFIG=${KERNEL_DEFCONFIG:-defconfig}
KERNEL_DTB=${KERNEL_DTB:-mediatek/mt7988a-bananapi-bpi-r4.dtb}
KERNEL_TAR_NAME=${KERNEL_TAR_NAME:-bpi-r4_kernel.tar.gz}
